{
	"name": "cloudflare-workers-openapi",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"lint": "oxlint src",
		"lint:fix": "oxlint --fix src",
		"check": "tsgo --noEmit",
		"typecheck:coverage": "type-coverage -p tsconfig.json --at-least 100 --ignore-files \"**/*.test.ts\"",
		"test": "vitest run",
		"test:unit": "vitest run --coverage",
		"test:watch": "vitest",
		"cov:html": "vitest run --coverage --coverage.reporter=html",
		"cov:lcov": "vitest run --coverage --coverage.reporter=lcov"
	},
	"dependencies": {
		"@hono/swagger-ui": "^0.5.3",
		"@hono/zod-openapi": "^1.6.0",
		"drizzle-orm": "^0.36.4",
		"hono": "^4.13.2",
		"webmention-handler": "^0.0.9",
		"webmentions-handler-drizzle": "workspace:*",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.20.1",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vitest/coverage-v8": "^2.1.9",
		"better-sqlite3": "^11.10.0",
		"drizzle-kit": "^0.30.6",
		"miniflare": "^4.20260730.0",
		"oxlint": "^1.78.0",
		"oxlint-tsgolint": "^7.0.2001",
		"type-coverage": "^2.30.1",
		"typescript": "^5.9.3",
		"vitest": "^2.1.9",
		"wrangler": "^4.123.0"
	}
}
